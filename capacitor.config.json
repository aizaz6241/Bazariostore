{
  "appId": "com.bazario.marketplace",
  "appName": "Bazario",
  "webDir": "client/dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "http://localhost:5000",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0f172a",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#2563eb"
    }
  }
}
