{
  "name": "bazario-marketplace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm install --include=dev --prefix client && npm run build --prefix client",
    "start": "node server/src/index.js",
    "seed": "node server/src/seed.js",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "npm run dev --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "socket.io": "^4.7.5",
    "uploadthing": "^7.7.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.2"
  },
  "engines": {
    "node": ">=20"
  }
}
